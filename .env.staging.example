# Public frontend configuration only. Copy to .env.staging.local locally or
# configure these values in the staging hosting platform. Never put server
# secrets or Google OAuth credentials in a VITE_* variable.
VITE_APP_ENV=staging
VITE_PRODUCTION_SUPABASE_PROJECT_REF=REPLACE_WITH_PRODUCTION_PROJECT_REF
VITE_STAGING_SUPABASE_PROJECT_REF=REPLACE_WITH_DIFFERENT_STAGING_PROJECT_REF
VITE_SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
VITE_DOCUMENT_SERVICE_URL=https://document-service-staging.example.com
