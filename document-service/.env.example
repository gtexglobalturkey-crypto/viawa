# Non-secret runtime configuration
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DOCUMENT_TEMPLATE_PATH=/opt/viawa/templates/VIAWA_Sozlesme_Sablonu_v2.3_1_Doldurulabilir.docx
DOCUMENT_TEMP_ROOT=/tmp/viawa-document-service
LIBREOFFICE_BINARY_PATH=/usr/bin/libreoffice
PDF_CONVERSION_TIMEOUT_MS=30000
PDF_CONVERSION_MAX_CONCURRENCY=2
PDF_CONVERSION_MAX_FILE_SIZE_BYTES=10485760
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://replace-with-approved-origin.example
HTTP_REQUEST_BODY_LIMIT_BYTES=16384

# Server-side Supabase configuration. Replace through the deployment platform.
SUPABASE_URL=https://replace-with-project.supabase.co
SUPABASE_ANON_KEY=

# SECRET: inject from a secret manager. Never commit it, bake it into an image,
# expose it in logs, or send it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
