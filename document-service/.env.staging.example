NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DOCUMENT_TEMPLATE_PATH=/opt/viawa/templates/VIAWA_Sozlesme_Sablonu_v2.3_1_Doldurulabilir.docx
DOCUMENT_TEMP_ROOT=/tmp/viawa-document-service
LIBREOFFICE_BINARY_PATH=/usr/bin/libreoffice
PDF_CONVERSION_TIMEOUT_MS=30000
PDF_CONVERSION_MAX_CONCURRENCY=2
PDF_CONVERSION_MAX_FILE_SIZE_BYTES=10485760
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=https://viawa-staging.example.com
HTTP_REQUEST_BODY_LIMIT_BYTES=16384

# Staging Supabase only. Inject through the Document Service staging secret manager.
SUPABASE_URL=https://STAGING_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_SECRET_MANAGER_ONLY

# Server-only Google Workspace OAuth values. Never expose as VITE_* variables.
GOOGLE_WORKSPACE_CLIENT_ID=REPLACE_IN_SECRET_MANAGER_ONLY
GOOGLE_WORKSPACE_CLIENT_SECRET=REPLACE_IN_SECRET_MANAGER_ONLY
GOOGLE_WORKSPACE_REFRESH_TOKEN=REPLACE_IN_SECRET_MANAGER_ONLY
VIAWA_MASTER_CONTRACT_TEMPLATE_ID=REPLACE_WITH_APPROVED_MASTER_DOCUMENT_ID
VIAWA_GENERATED_DOCUMENTS_FOLDER_ID=REPLACE_WITH_STAGING_DRIVE_FOLDER_ID
